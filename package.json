{
  "name": "prepify",
  "version": "1.0.0",
  "description": "Prepify - Make knowledge your next adventure. AI-powered gamified study platform.",
  "scripts": {
    "install:all": "npm run install:server && npm run install:client",
    "install:server": "cd server && npm install",
    "install:client": "cd client && npm install",
    "server": "cd server && node server.js",
    "client": "cd client && npm run dev",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "build": "npm install --prefix client --include=dev && npm run build --prefix client",
    "vercel:login": "npx vercel login",
    "vercel:dev": "npx vercel dev",
    "vercel:deploy": "npx vercel --prod"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "dependencies": {
    "@google/genai": "^3.2.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "google-auth-library": "^10.9.1",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^7.9.0",
    "mongoose": "^8.4.1",
    "multer": "^1.4.5-lts.1",
    "pdf-parse": "^1.1.1"
  }
}
